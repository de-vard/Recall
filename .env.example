# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,re-call.ru,re-call.store,155.212.145.145

# PostgreSQL
DB_NAME=recall
DB_USER=recall
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# MongoDB
MONGO_URI=mongodb://mongo:27017/
MONGO_DB_NAME=flashcard_snapshots

# Redis
REDIS_URL=redis://redis:6379/1

# Elasticsearch
ELASTIC_HOST=http://elasticsearch:9200

# OAuth (optional — leave empty to disable social login)
AUTH_GITHUB_KEY=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_OAUTH2_KEY=
AUTH_GOOGLE_OAUTH2_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/social/google/

# Frontend (build-time, set before docker compose build)
REACT_APP_BASE_URL=/api/v1
REACT_APP_GITHUB_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_REDIRECT_URI=http://localhost/auth/callback

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@re-call.ru

# Superuser (created on first start if not exists)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin

# Host port for frontend (nginx)
HTTP_PORT=80